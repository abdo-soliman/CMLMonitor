<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        /* Base Styles */
        body { 
            margin: 0; 
            padding: 0; 
            background-color: #f4f7f9; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
        }
        
        /* Container */
        .outer-wrapper { width: 100%; background-color: #f4f7f9; }
        .main-container { 
            max-width: 900px; 
            margin: 0 auto; 
            background-color: #ffffff; 
            border: 1px solid #e0e0e0; 
        }

        /* Header */
        .header { 
            background-color: #d9534f; 
            padding: 25px; 
            text-align: center; 
            color: #ffffff; 
        }
        .header h1 { margin: 0; font-size: 24px; letter-spacing: 1px; }

        /* Content Blocks */
        .content-padding { padding: 30px; }
        .alert-banner { 
            background-color: #fff5f5; 
            border-left: 5px solid #d9534f; 
            padding: 15px; 
            color: #b91c1c; 
            font-size: 14px; 
            margin-bottom: 25px; 
        }

        /* Summary Grid - Table Fallback */
        .summary-table { width: 100%; margin-bottom: 25px; }
        .summary-card { 
            background-color: #f8f9fa; 
            border: 1px solid #eeeeee; 
            padding: 15px; 
            text-align: center; 
        }
        .summary-label { color: #666666; font-size: 11px; text-transform: uppercase; }
        .summary-value { font-size: 18px; font-weight: bold; color: #d9534f; }

        /* Data Table */
        .metrics-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .metrics-table th { 
            background-color: #f8f9fa; 
            color: #555555; 
            padding: 12px; 
            border-bottom: 2px solid #dee2e6; 
            text-align: left; 
        }
        .metrics-table td { 
            padding: 12px; 
            border-bottom: 1px solid #eeeeee; 
            vertical-align: middle; 
        }
        
        /* Badges */
        .badge-id { font-family: monospace; background-color: #eeeeee; padding: 2px 5px; font-size: 12px; }
        .badge-status { background-color: #def7ec; color: #03543f; padding: 4px 8px; font-size: 11px; font-weight: bold; }

        /* Footer */
        .footer { 
            font-size: 12px; 
            color: #888888; 
            text-align: center; 
            padding: 20px; 
            background-color: #fcfcfc; 
            border-top: 1px solid #eeeeee; 
        }

        /* Mobile Adjustments */
        @media screen and (max-width: 600px) {
            .summary-table td { display: block; width: 100% !important; margin-bottom: 10px; }
            .metrics-table { font-size: 11px; }
            .content-padding { padding: 15px; }
        }
    </style>
</head>
<body>
    <table class="outer-wrapper" border="0" cellpadding="0" cellspacing="0">
        <tr>
            <td align="center" style="padding: 20px 0;">
                <table class="main-container" border="0" cellpadding="0" cellspacing="0" width="95%">
                    
                    <tr>
                        <td class="header" bgcolor="#d9534f">
                            <h1>🚨 Zombie Sessions Alert</h1>
                        </td>
                    </tr>

                    <tr>
                        <td class="content-padding">
                            
                            <div class="alert-banner">
                                <strong>Attention Required:</strong> The following sessions have been identified as "Zombie" (active beyond expected duration or idle). Please review them to reclaim cluster resources.
                            </div>

                            <table class="summary-table" border="0" cellpadding="0" cellspacing="10">
                                <tr>
                                    <td class="summary-card" width="33%" bgcolor="#f8f9fa">
                                        <div class="summary-label">Zombie Count</div>
                                        <div class="summary-value">{{ total_zombies }} Detected</div>
                                    </td>
                                    <td class="summary-card" width="33%" bgcolor="#f8f9fa">
                                        <div class="summary-label">Total Wasted CPU</div>
                                        <div class="summary-value">{{ total_cpu }} vCPU</div>
                                    </td>
                                    <td class="summary-card" width="33%" bgcolor="#f8f9fa">
                                        <div class="summary-label">Total Wasted RAM</div>
                                        <div class="summary-value">{{ total_ram }} GiB</div>
                                    </td>
                                </tr>
                            </table>

                            <div style="overflow-x:auto;">
                                <table class="metrics-table" border="0" cellpadding="0" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>User Details</th>
                                            <th>Project / Session</th>
                                            <th>Namespace / Pod</th>
                                            <th>Status</th>
                                            <th>Age</th>
                                            <th>Resources</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for zombie in zombies %}
                                        <tr>
                                            <td>
                                                <strong>{{ zombie.user }}</strong>
                                                {% if zombie.show_full_name %}<br><span style="color:#666666;">{{ zombie.full_name }}</span>{% endif %}
                                            </td>
                                            <td>
                                                <strong>{{ zombie.project }}</strong><br>
                                                <span style="color:#666666;">{{ zombie.name }}</span>
                                            </td>
                                            <td>
                                                <span style="color:#666666;">{{ zombie.namespace }}</span><br>
                                                <span class="badge-id">{{ zombie.id }}</span>
                                            </td>
                                            <td><span class="badge-status">{{ zombie.status }}</span></td>
                                            <td>{{ zombie.age }}</td>
                                            <td><span style="font-size:11px;">{{ zombie.cpu }} vCPU / {{ zombie.ram }} GiB</span></td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="footer" bgcolor="#fcfcfc">
                            Automated Governance Service • Kubemonitor • {{ datetime }}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>